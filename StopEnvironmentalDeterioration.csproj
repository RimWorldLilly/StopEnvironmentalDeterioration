<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StopEnvironmentalDeterioration</AssemblyName>
    <RootNamespace>Lilly.StopEnvironmentalDeterioration</RootNamespace>
    <OutputPath>1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildProjectDirectory)\..\..</GameRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameRoot)\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)\Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll not found. Expected: $(GameRoot)\Assembly-CSharp.dll" />
    <Error Condition="!Exists('$(GameRoot)\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll')"
           Text="0Harmony.dll not found. Expected: $(GameRoot)\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll" />
  </Target>
</Project>
